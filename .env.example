# ==============================================================================
# Environment Configuration Template: Automated Python PCAP Analyzer
# Copy to .env for local runtime. NEVER commit actual .env or secrets to git.
# ==============================================================================

# Application Environment: development | test | production
APP_ENV=development
DEBUG=true

# Server & Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
PORT=3000

# Resource & Processing Limits
MAX_UPLOAD_SIZE_MB=50
MAX_CONCURRENT_ANALYSES=2
ANALYSIS_TIMEOUT_SECONDS=60
RETENTION_DAYS=7

# Default Profiles & Engines
DEFAULT_PROFILE=default
DEFAULT_ENGINE=auto

# Storage Configuration
DATA_DIRECTORY=./data

# CORS Policy (Comma-separated origins; explicit origins required in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Platform Context (Injected automatically in AI Studio environment)
GEMINI_API_KEY=""
APP_URL=""
